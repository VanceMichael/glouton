+// faultWAL wraps a WAL file and injects write/sync failures.
+type faultWAL struct {
+	walFile
+	writeErr error
+	syncErr  error
+}
+
+func (f *faultWAL) Write(p []byte) (int, error) {
+	if f.writeErr != nil {
+		return 0, f.writeErr
+	}
+
+	return f.walFile.Write(p)
+}
+
+func (f *faultWAL) Sync() error {
+	if f.syncErr != nil {
+		return f.syncErr
+	}
+
+	return f.walFile.Sync()
+}
