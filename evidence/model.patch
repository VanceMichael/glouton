+		if fifo.readIdx == fifo.size {
+			fifo.readIdx = 0
+		}
+
+		fifo.writeReadDiff--
+		v := fifo.queue[fifo.readIdx]
+		fifo.queue[fifo.readIdx] = fifo.zero
