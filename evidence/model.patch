+	if err := s2.enable(cfg); !errors.Is(err, errSpoolLocked) {
+		t.Fatalf("enable on locked spool = %v, want errSpoolLocked", err)
+	}
+
+	// The locked handle is not an owner: close it without touching files.
+	_ = s2.Close()
+}
