+			_ = s2.Close()
+		}
+
+		t.Fatalf("second open error = %v, want errSpoolLocked", err)
+	}
+
+	if s2 == nil || !s2.Snapshot().Locked {
+		t.Fatal("locked spool must be exposed with Locked=true for diagnostics")
+	}
